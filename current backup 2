<script>


/* =====================================================
   PRAYER DATA
   ===================================================== */

let prayerTimes = {};


/* =====================================================
   ISLAMIC MONTH NAMES
   ===================================================== */

const hijriMonths = [

    "Muharram",

    "Safar",

    "Rabi' al-Awwal",

    "Rabi' al-Thani",

    "Jumada al-Awwal",

    "Jumada al-Thani",

    "Rajab",

    "Sha'ban",

    "Ramadan",

    "Shawwal",

    "Dhul-Qi'dah",

    "Dhul-Hijjah"

];


/* =====================================================
   GET HIJRI FORMATTER
   ===================================================== */

function getHijriFormatter() {

    try {

        return new Intl.DateTimeFormat(
            "en-US-u-ca-islamic-umalqura",
            {
                day: "numeric",
                month: "numeric",
                year: "numeric"
            }
        );

    }

    catch (error) {

        return new Intl.DateTimeFormat(
            "en-US-u-ca-islamic",
            {
                day: "numeric",
                month: "numeric",
                year: "numeric"
            }
        );
    }
}


/* =====================================================
   GET HIJRI PARTS
   ===================================================== */

function getHijriParts(date = new Date()) {

    const formatter =
        getHijriFormatter();


    const parts =
        formatter.formatToParts(date);


    const result = {};


    parts.forEach(part => {

        if (
            part.type === "day" ||
            part.type === "month" ||
            part.type === "year"
        ) {

            result[part.type] =
                parseInt(
                    part.value,
                    10
                );
        }

    });


    return result;
}


/* =====================================================
   GET HIJRI DATE
   ===================================================== */

function getHijriDate(date = new Date()) {

    const hijri =
        getHijriParts(date);


    const day =
        hijri.day;


    const month =
        hijriMonths[hijri.month - 1];


    const year =
        hijri.year;


    return (
        day +
        " " +
        month +
        " " +
        year
    );
}


/* =====================================================
   FIND NEXT RAMADAN
   ===================================================== */

function findNextRamadan() {

    const today =
        new Date();


    const testDate =
        new Date(
            today.getFullYear(),
            today.getMonth(),
            today.getDate()
        );


    for (let i = 0; i < 430; i++) {

        const hijri =
            getHijriParts(
                testDate
            );


        if (
            hijri.month === 9 &&
            hijri.day === 1
        ) {

            return new Date(testDate);
        }


        testDate.setDate(
            testDate.getDate() + 1
        );
    }


    return null;
}


/* =====================================================
   UPDATE RAMADAN
   ===================================================== */

function updateRamadanInfo() {

    const today =
        new Date();


    const hijri =
        getHijriParts(today);


    const hijriDate =
        getHijriDate(today);


    document.getElementById(
        "hijri-date"
    ).textContent =
        hijriDate + " AH";


    if (hijri.month === 9) {

        document.getElementById(
            "ramadan-info"
        ).textContent =
            "🌙 Ramadan Day " +
            hijri.day;

        return;
    }


    const nextRamadan =
        findNextRamadan();


    if (!nextRamadan) {

        document.getElementById(
            "ramadan-info"
        ).textContent =
            "🌙 Ramadan";

        return;
    }


    const todayStart =
        new Date(
            today.getFullYear(),
            today.getMonth(),
            today.getDate()
        );


    const ramadanStart =
        new Date(
            nextRamadan.getFullYear(),
            nextRamadan.getMonth(),
            nextRamadan.getDate()
        );


    const difference =
        ramadanStart -
        todayStart;


    const daysRemaining =
        Math.ceil(
            difference /
            (1000 * 60 * 60 * 24)
        );


    if (daysRemaining === 1) {

        document.getElementById(
            "ramadan-info"
        ).textContent =
            "🌙 Ramadan starts tomorrow";

    }

    else {

        document.getElementById(
            "ramadan-info"
        ).textContent =
            "🌙 Ramadan in " +
            daysRemaining +
            " days";
    }
}


/* =====================================================
   CONVERT TIME TO MINUTES
   ===================================================== */

function convertToMinutes(timeString) {

    if (!timeString) {

        return null;
    }


    timeString =
        timeString.trim();


    const match =
        timeString.match(
            /^(\d{1,2}):(\d{2})\s*(AM|PM)$/i
        );


    if (!match) {

        return null;
    }


    let hours =
        parseInt(
            match[1],
            10
        );


    const minutes =
        parseInt(
            match[2],
            10
        );


    const period =
        match[3].toUpperCase();


    if (period === "AM") {

        if (hours === 12) {

            hours = 0;
        }

    }

    else {

        if (hours !== 12) {

            hours += 12;
        }
    }


    return (
        hours * 60
    ) + minutes;
}


/* =====================================================
   WRAP ROW TEXT
   ===================================================== */

function prepareRow(rowId) {

    const row =
        document.getElementById(
            rowId
        );


    if (!row) {

        return;
    }


    const cells =
        row.querySelectorAll(
            "td"
        );


    cells.forEach(cell => {

        if (
            cell.querySelector(
                ".prayer-text"
            )
        ) {

            return;
        }


        const text =
            cell.textContent;


        cell.textContent = "";


        const span =
            document.createElement(
                "span"
            );


        span.className =
            "prayer-text";


        span.textContent =
            text;


        cell.appendChild(
            span
        );
    });
}


/* =====================================================
   FLASH ONLY TEXT
   ===================================================== */

function setFlash(rowId, flash) {

    const row =
        document.getElementById(
            rowId
        );


    if (!row) {

        return;
    }


    prepareRow(rowId);


    const spans =
        row.querySelectorAll(
            ".prayer-text"
        );


    spans.forEach(span => {

        if (flash) {

            span.classList.add(
                "flash-text"
            );

        }

        else {

            span.classList.remove(
                "flash-text"
            );
        }

    });
}


/* =====================================================
   FIND NEXT PRAYER
   ===================================================== */

function highlightNextPrayer() {

    if (
        !prayerTimes.fajrIqamah
    ) {

        return;
    }


    const now =
        new Date();


    const currentMinutes =
        (now.getHours() * 60) +
        now.getMinutes();


    const prayers = [

        {
            row: "fajr-row",
            iqamah:
                prayerTimes.fajrIqamah
        },

        {
            row: "zuhr-row",
            iqamah:
                prayerTimes.zuhrIqamah
        },

        {
            row: "asr-row",
            iqamah:
                prayerTimes.asrIqamah
        },

        {
            row: "maghrib-row",
            iqamah:
                prayerTimes.maghribIqamah
        },

        {
            row: "isha-row",
            iqamah:
                prayerTimes.ishaIqamah
        }

    ];


    let activePrayer = null;


    /* -----------------------------------------------
       FIRST CHECK:
       10 MINUTES AFTER IQAMAH
       ----------------------------------------------- */

    for (
        const prayer of prayers
    ) {

        const iqamahMinutes =
            convertToMinutes(
                prayer.iqamah
            );


        if (
            iqamahMinutes === null
        ) {

            continue;
        }


        const highlightUntil =
            iqamahMinutes + 10;


        if (
            currentMinutes >=
            iqamahMinutes &&

            currentMinutes <
            highlightUntil
        ) {

            activePrayer =
                prayer.row;

            break;
        }
    }


    /* -----------------------------------------------
       OTHERWISE FIND NEXT PRAYER
       ----------------------------------------------- */

    if (!activePrayer) {

        for (
            const prayer of prayers
        ) {

            const iqamahMinutes =
                convertToMinutes(
                    prayer.iqamah
                );


            if (
                iqamahMinutes !== null &&

                iqamahMinutes >
                currentMinutes
            ) {

                activePrayer =
                    prayer.row;

                break;
            }
        }
    }


    /* -----------------------------------------------
       AFTER ISHA:
       USE FAJR
       ----------------------------------------------- */

    if (!activePrayer) {

        activePrayer =
            "fajr-row";
    }


    /* -----------------------------------------------
       STOP EVERY ROW FROM FLASHING
       ----------------------------------------------- */

    prayers.forEach(
        prayer => {

            setFlash(
                prayer.row,
                false
            );

        }
    );


    /* -----------------------------------------------
       FLASH ONLY ACTIVE PRAYER
       ----------------------------------------------- */

    setFlash(
        activePrayer,
        true
    );
}


/* =====================================================
   FETCH PRAYER TIMES
   ===================================================== */

async function fetchPrayerTimes() {

    try {

        const response =
            await fetch(
                "https://masjidal.com/api/v1/time/range?masjid_id=PAPyordJ"
            );


        if (!response.ok) {

            throw new Error(
                "Prayer API returned HTTP " +
                response.status
            );
        }


        const data =
            await response.json();


        if (
            !data ||
            !data.data ||
            !data.data.salah ||
            !data.data.iqamah ||
            !data.data.salah.length ||
            !data.data.iqamah.length
        ) {

            throw new Error(
                "Invalid prayer data received"
            );
        }


        const salah =
            data.data.salah[0];


        const iqamah =
            data.data.iqamah[0];


        /* -------------------------------------------
           CURRENT DATE
           ------------------------------------------- */

        document.getElementById(
            "current-date"
        ).textContent =
            salah.date;


        /* -------------------------------------------
           SAVE IQAMAH TIMES
           ------------------------------------------- */

        prayerTimes = {

            fajrIqamah:
                iqamah.fajr,

            zuhrIqamah:
                iqamah.zuhr,

            asrIqamah:
                iqamah.asr,

            maghribIqamah:
                iqamah.maghrib,

            ishaIqamah:
                iqamah.isha
        };


        /* -------------------------------------------
           FAJR
           ------------------------------------------- */

        document.getElementById(
            "fajr-time"
        ).textContent =
            salah.fajr;


        document.getElementById(
            "fajr-iqamah"
        ).textContent =
            iqamah.fajr;


        /* -------------------------------------------
           ZUHR
           ------------------------------------------- */

        document.getElementById(
            "zuhr-time"
        ).textContent =
            salah.zuhr;


        document.getElementById(
            "zuhr-iqamah"
        ).textContent =
            iqamah.zuhr;


        /* -------------------------------------------
           ASR
           ------------------------------------------- */

        document.getElementById(
            "asr-time"
        ).textContent =
            salah.asr;


        document.getElementById(
            "asr-iqamah"
        ).textContent =
            iqamah.asr;


        /* -------------------------------------------
           MAGHRIB
           ------------------------------------------- */

        document.getElementById(
            "maghrib-time"
        ).textContent =
            salah.maghrib;


        document.getElementById(
            "maghrib-iqamah"
        ).textContent =
            iqamah.maghrib;


        /* -------------------------------------------
           ISHA
           ------------------------------------------- */

        document.getElementById(
            "isha-time"
        ).textContent =
            salah.isha;


        document.getElementById(
            "isha-iqamah"
        ).textContent =
            iqamah.isha;


        /* -------------------------------------------
           UPDATE ACTIVE PRAYER
           ------------------------------------------- */

        highlightNextPrayer();

    }

    catch (error) {

        console.error(
            "Unable to load prayer times:",
            error
        );
    }
}


/* =====================================================
   UPDATE DISPLAY
   ===================================================== */

function updateDisplay() {

    updateRamadanInfo();

    highlightNextPrayer();
}


/* =====================================================
   START
   ===================================================== */

fetchPrayerTimes();

updateDisplay();


/* =====================================================
   UPDATE ACTIVE PRAYER EVERY SECOND
   ===================================================== */

setInterval(
    updateDisplay,
    1000
);


/* =====================================================
   REFRESH PRAYER TIMES EVERY 24 HOURS
   ===================================================== */

setInterval(
    fetchPrayerTimes,
    24 * 60 * 60 * 1000
);

</script>


